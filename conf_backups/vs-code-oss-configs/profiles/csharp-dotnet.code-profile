  "settings": "{\"settings\": \"{\\n  \\\"editor.fontSize\\\": 14,\\n  \\\"editor.fontFamily\\\": \\\"JetBrainsMono Nerd Font\\\",\\n  \\\"editor.fontLigatures\\\": true,\\n  \\\"editor.mouseWheelZoom\\\": true,\\n  \\\"editor.rulers\\\": [\\n    120\\n  ],\\n  \\\"editor.smoothScrolling\\\": true,\\n  \\\"editor.cursorSmoothCaretAnimation\\\": \\\"on\\\",\\n  \\\"editor.cursorStyle\\\": \\\"line\\\",\\n  \\\"editor.tabSize\\\": 3,\\n  \\\"editor.detectIndentation\\\": true,\\n  \\\"editor.renderWhitespace\\\": \\\"all\\\",\\n  \\\"chat.disableAIFeatures\\\": true,\\n\\n  \\\"editor.inlineSuggest.enabled\\\": true,\\n  \\\"editor.suggest.preview\\\": true,\\n\\n  \\\"editor.quickSuggestions\\\": {\\n    \\\"other\\\": true,\\n    \\\"comments\\\": false,\\n    \\\"strings\\\": true\\n  },\\n  \\\"editor.suggestOnTriggerCharacters\\\": true,\\n  \\\"editor.wordBasedSuggestions\\\": \\\"matchingDocuments\\\",\\n  \\\"editor.tabCompletion\\\": \\\"on\\\",\\n  \\\"workbench.colorCustomizations\\\": {\\n    \\\"editorRuler.foreground\\\": \\\"#9a9a9a\\\",\\n    \\\"errorLens.warningBackground\\\": \\\"#fff0\\\",\\n    \\\"errorLens.warningMessageBackground\\\": \\\"#fff0\\\",\\n    \\\"errorLens.warningForeground\\\": \\\"#fff0\\\",\\n    \\\"errorLens.infoBackground\\\": \\\"#fff0\\\",\\n    \\\"errorLens.infoMessageBackground\\\": \\\"#fff0\\\",\\n    \\\"errorLens.infoForeground\\\": \\\"#fff0\\\"\\n  },\\n  \\\"workbench.colorTheme\\\": \\\"One Dark Pro Darker\\\",\\n  \\\"workbench.iconTheme\\\": \\\"vscode-icons\\\",\\n  \\\"workbench.startupEditor\\\": \\\"none\\\",\\n  \\\"workbench.tree.indent\\\": 20,\\n  \\\"workbench.sideBar.location\\\": \\\"right\\\",\\n  \\\"workbench.list.smoothScrolling\\\": true,\\n  \\\"workbench.editor.enablePreview\\\": false,\\n  \\\"workbench.tree.enableStickyScroll\\\": false,\\n  \\\"workbench.tree.renderIndentGuides\\\": \\\"always\\\",\\n  \\\"window.titleBarStyle\\\": \\\"custom\\\",\\n  \\\"window.title\\\": \\\"~\\\\\\\\${ac