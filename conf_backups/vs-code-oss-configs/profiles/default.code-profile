  "settings": "{\"settings\": \"{\\n  \\\"editor.mouseWheelZoom\\\": true,\\n  \\\"editor.rulers\\\": [\\n    120\\n  ],\\n  \\\"errorLens.gutterIconsEnabled\\\": true,\\n  \\\"errorLens.gutterIconSet\\\": \\\"emoji\\\",\\n  \\\"workbench.colorCustomizations\\\": {\\n    \\\"editorRuler.foreground\\\": \\\"#9a9a9a\\\",\\n    \\\"errorLens.warningBackground\\\": \\\"#fff0\\\",\\n    \\\"errorLens.warningMessageBackground\\\": \\\"#fff0\\\",\\n    \\\"errorLens.warningForeground\\\": \\\"#fff0\\\"\\n  },\\n  \\\"search.mode\\\": \\\"reuseEditor\\\",\\n  \\\"breadcrumbs.enabled\\\": true,\\n  \\\"window.titleBarStyle\\\": \\\"custom\\\",\\n  \\\"window.title\\\": \\\"~\\\\\\\\${activeFolderMedium}\\\",\\n  \\\"workbench.tree.indent\\\": 20,\\n  \\\"workbench.sideBar.location\\\": \\\"right\\\",\\n  \\\"workbench.list.smoothScrolling\\\": true,\\n  \\\"workbench.editor.enablePreview\\\": false,\\n  \\\"workbench.tree.enableStickyScroll\\\": false,\\n  \\\"workbench.tree.renderIndentGuides\\\": \\\"always\\\",\\n  \\\"editor.fontSize\\\": 14,\\n  \\\"editor.glyphMargin\\\": true,\\n  \\\"editor.fontLigatures\\\": true,\\n  \\\"editor.indentSize\\\": \\\"tabSize\\\",\\n  \\\"editor.smoothScrolling\\\": true,\\n  \\\"editor.inlineSuggest.enabled\\\": true,\\n  \\\"editor.showFoldingControls\\\": \\\"never\\\",\\n  \\\"editor.scrollbar.vertical\\\": \\\"auto\\\",\\n  \\\"editor.scrollbar.horizontal\\\": \\\"hidden\\\",\\n  \\\"editor.cursorSmoothCaretAnimation\\\": \\\"on\\\",\\n  \\\"editor.fontFamily\\\": \\\"JetBrainsMono Nerd Font\\\",\\n  \\\"explorer.confirmDelete\\\": false,\\n  \\\"explorer.compactFolders\\\": false,\\n  \\\"explorer.fileNesting.expand\\\": false,\\n  \\\"explorer.autoReveal\\\": \\\"focusNoScroll\\\",\\n  \\\"debug.inlineValues\\\": \\\"on\\\",\\n  \\\"debugpy.debugJustMyCode\\\": true,\\n  \\\"debug.toolBarLocation\\\": \\\"hidden\\\",\\n  \\\"debug.internalConsoleOptions\\\": \\\"neverOpen\\\",\\n  \\\"terminal.integrated.smoothScrolling\\\": true,\\n  \\\"telemetry.telemetryLevel\\\": \\\"off\\\",\\n  \\\"dotnetAcquisitionExtension.enableTelemetry\\\": false,\\n  \\\"files.exclude\\\": {\\n    \\\"**/.git\\\": true,\\n    \\\"**/.vscode\\\": true,\\n    \\\"**/.plastic\\\": true\\n  },\\n  \\\"color-highlight.matchWords\\\": true,\\n  \\\"color-highlight.markerType\\\": \\\"dot-before\\\",\\n  \\\"files.hotExit\\\": \\\"onExitAndWindowClose\\\",\\n  \\\"window.restoreWindows\\\": \\\"folders\\\",\\n  \\\"files.autoSave\\\": \\\"onFocusChange\\\",\\n  \\\"git.enableSmartCommit\\\": true,\\n  \\\"workbench.startupEditor\\\": \\\"none\\\",\\n  \\\"editor.renderWhitespace\\\": \\\"all\\\",\\n  \\\"terminal.integrated.copyOnSelection\\\": true,\\n  \\\"terminal.integrated.cursorBlinking\\\": true,\\n  \\\"terminal.integrated.cursorWidth\\\": 2,\\n  \\\"terminal.integrated.cursorStyle\\\": \\\"line\\\",\\n  \\\"[c]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"xaver.clang-format\\\"\\n  },\\n  \\\"[cpp]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"xaver.clang-format\\\"\\n  },\\n  \\\"[java]\\\": {\\n    \\\"editor.defaultFormatter\\\": null\\n  },\\n  \\\"[python]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"charliermarsh.ruff\\\",\\n    \\\"editor.tabSize\\\": 3,\\n    \\\"editor.insertSpaces\\\": true,\\n    \\\"editor.detectIndentation\\\": true\\n  },\\n  \\\"clang-format.language.cpp.enable\\\": true,\\n  \\\"clang-format.language.cpp.style\\\": \\\"{UseTab: Always ,IndentWidth: 3 }\\\",\\n  \\\"code-runner.runInTerminal\\\": true,\\n  \\\"code-runner.saveFileBeforeRun\\\": true,\\n  \\\"terminal.integrated.enableMultiLinePasteWarning\\\": \\\"auto\\\",\\n  \\\"debug.onTaskErrors\\\": \\\"showErrors\\\",\\n  \\\"terminal.integrated.tabs.location\\\": \\\"left\\\",\\n  \\\"editor.unicodeHighlight.ambiguousCharacters\\\": false,\\n  \\\"editor.unicodeHighlight.allowedCharacters\\\": {\\n    \\\"\\\\u00a0\\\": true\\n  },\\n  \\\"notebook.lineNumbers\\\": \\\"on\\\",\\n  \\\"hexeditor.columnWidt