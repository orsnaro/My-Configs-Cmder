{
  "editor.mouseWheelZoom": true,
  "editor.rulers": [
    120
  ],
  "errorLens.gutterIconsEnabled": true,
  "errorLens.gutterIconSet": "emoji",
  "workbench.colorCustomizations": {
    "editorRuler.foreground": "#9a9a9a",
    "errorLens.warningBackground": "#fff0",
    "errorLens.warningMessageBackground": "#fff0",
    "errorLens.warningForeground": "#fff0"
  },
  "search.mode": "reuseEditor",
  "breadcrumbs.enabled": true,
  "window.titleBarStyle": "custom",
  "window.title": "~\\${activeFolderMedium}",
  "workbench.tree.indent": 20,
  "workbench.sideBar.location": "right",
  "workbench.list.smoothScrolling": true,
  "workbench.editor.enablePreview": false,
  "workbench.tree.enableStickyScroll": false,
  "workbench.tree.renderIndentGuides": "always",
  "editor.fontSize": 14,
  "editor.glyphMargin": true,
  "editor.fontLigatures": true,
  "editor.indentSize": "tabSize",
  "editor.smoothScrolling": true,
  "editor.inlineSuggest.enabled": true,
  "editor.showFoldingControls": "never",
  "editor.scrollbar.vertical": "auto",
  "editor.scrollbar.horizontal": "hidden",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "explorer.confirmDelete": false,
  "explorer.compactFolders": false,
  "explorer.fileNesting.expand": false,
  "explorer.autoReveal": "focusNoScroll",
  "debug.inlineValues": "on",
  "debugpy.debugJustMyCode": true,
  "debug.toolBarLocation": "hidden",
  "debug.internalConsoleOptions": "neverOpen",
  "terminal.integrated.smoothScrolling": true,
  "telemetry.telemetryLevel": "off",
  "dotnetAcquisitionExtension.enableTelemetry": false,
  "files.exclude": {
    "**/.git": true,
    "**/.vscode": true,
    "**/.plastic": true
  },
  "color-highlight.matchWords": true,
  "color-highlight.markerType": "dot-before",
  "files.hotExit": "onExitAndWindowClose",
  "window.restoreWindows": "folders",
  "files.autoSave": "onFocusChange",
  "git.enableSmartCommit": true,
  "workbench.startupEditor": "none",
  "editor.renderWhitespace": "all",
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorWidth": 2,
  "terminal.integrated.cursorStyle": "line",
  "[c]": {
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "[java]": {
    "editor.defaultFormatter": null
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.tabSize": 3,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true
  },
  "clang-format.language.cpp.enable": true,
  "clang-format.language.cpp.style": "{UseTab: Always ,IndentWidth: 3 }",
  "code-runner.runInTerminal": true,
  "code-runner.saveFileBeforeRun": true,
  "terminal.integrated.enableMultiLinePasteWarning": "auto",
  "debug.onTaskErrors": "showErrors",
  "terminal.integrated.tabs.location": "left",
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.unicodeHighlight.allowedCharacters": {
    "\u00a0": true
  },
  "notebook.lineNumbers": "on",
  "hexeditor.columnWidth": 16,
  "hexeditor.showDecodedText": true,
  "hexeditor.defaultEndianness": "little",
  "hexeditor.inspectorType": "aside",
  "security.workspace.trust.untrustedFiles": "open",
  "notebook.output.textLineLimit": 1000,
  "[cmake]": {},
  "cmake.configureOnOpen": true,
  "editor.detectIndentation": true,
  "editor.tabSize": 3,
  "prettier.useTabs": true,
  "terminal.integrated.defaultProfile.linux": "bash",
  "editor.insertSpaces": true,
  "tabnine.experimentalAutoImports": true,
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  "grammarly.files.include": [
    "**/readme.md",
    "**/README.md",
    "**/*.txt",
    "**/*.ipynb"
  ],
  "grammarly.selectors": [],
  "python.linting.pylintArgs": [
    "--load-plugins",
    "pylint_django"
  ],
  "pylint.importStrategy": "fromEnvironment",
  "pylint.showNotifications": "onError",
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "workbench.editorAssociations": {
    "*.html": "default"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
  },
  "gitlens.views.branches.files.layout": "list",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "workbench.layoutControl.enabled": false,
  "files.associations": {
    "*.cpp": "cpp"
  },
  "terminal.integrated.fontWeight": "normal",
  "settingsSync.ignoredExtensions": [],
  "vscode-pets.throwBallWithMouse": true,
  "bitoAI.codeCompletion.enableAutoCompletion": true,
  "bitoAI.codeCompletion.enableCommentToCode": true,
  "editor.inlineSuggest.showToolbar": "always",
  "editor.stickyScroll.enabled": false,
  "json.schemas": [
    {
      "fileMatch": [
        "komorebi.json"
      ],
      "url": "https://raw.githubusercontent.com/LGUG2Z/komorebi/master/schema.json"
    }
  ],
  "git.openRepositoryInParentFolders": "always",
  "cmake.showOptionsMovedNotification": false,
  "explorer.confirmDragAndDrop": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "errorLens.excludePatterns": [
    "{**/*.md}"
  ],
  "workbench.colorTheme": "Gruvbox Dark Medium",
  "vscode-pets.petType": "cockatiel",
  "vscode-pets.petSize": "small",
  "vscode-pets.petColor": "magical",
  "markdown-pdf.breaks": true,
  "workbench.activityBar.location": "bottom",
  "liveServer.settings.donotShowInfoMsg": true,
  "remote.SSH.remotePlatform": {},
  "codesnap.showWindowTitle": true,
  "codesnap.shutterAction": "copy",
  "codesnap.realLineNumbers": true,
  "window.menuStyle": "native",
  "window.controlsStyle": "hidden",
  "window.density.editorTabHeight": "compact",
  "workbench.editor.editorActionsLocation": "hidden",
  "window.menuBarVisibility": "compact",
  "chat.commandCenter.enabled": false,
  "window.commandCenter": false,
  "editor.minimap.enabled": false,
  "git.blame.editorDecoration.enabled": true,
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "editor.inlineSuggest.edits.showCollapsed": true,
  "claudeCode.preferredLocation": "sidebar",
  "playwright.reuseBrowser": false,
  "workbench.iconTheme": "vscode-icons",
  "chat.disableAIFeatures": true,
  "csharp-dev-tools.semanticColors.theme": "off",
  "csharp-dev-tools.homepage.enabled": true,
  "csharp-dev-tools.solutionViewer.expandCsFilesOutline": true,
  "csharp-dev-tools.solutionViewer.collapseOtherPaths": false
}
