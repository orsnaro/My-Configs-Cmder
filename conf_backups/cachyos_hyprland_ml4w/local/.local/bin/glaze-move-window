#!/usr/bin/env bash
set -euo pipefail

mode=direction
if [[ ${1:-} == monitor ]]; then mode=monitor; shift; fi
direction=${1:-}
case "$direction" in
    left) code=l ;;
    right) code=r ;;
    up) code=u ;;
    down) code=d ;;
    *) echo 'Usage: glaze-move-window [monitor] left|right|up|down' >&2; exit 2 ;;
esac

active=$(hyprctl activewindow -j)
monitor_id=$(jq -r '.monitor // empty' <<< "$active")
[[ -n $monitor_id ]] || exit 0

if [[ $mode == monitor ]]; then
    target=$(hyprctl monitors -j | jq -r --argjson id "$monitor_id" --arg direction "$direction" '
        def cx: .x + (.width / 2);
        def cy: .y + (.height / 2);
        . as $all | ($all[] | select(.id == $id)) as $current |
        [$all[] | select(.id != $id) |
            select(if $direction == "left" then .x + .width <= $current.x
                elif $direction == "right" then .x >= $current.x + $current.width
                elif $direction == "up" then .y + .height <= $current.y
                else .y >= $current.y + $current.height end) |
            {name, distance: (if ($direction == "left" or $direction == "right")
                then ((. | cx) - ($current | cx) | abs) + (((. | cy) - ($current | cy) | abs) / 1000)
                else ((. | cy) - ($current | cy) | abs) + (((. | cx) - ($current | cx) | abs) / 1000) end)}
        ] | min_by(.distance) | .name // empty
    ')
    if [[ -n $target ]]; then
        hyprctl dispatch "hl.dsp.window.move({ monitor = \"$target\", follow = true })" >/dev/null
        exit 0
    fi
fi

# No monitor in that direction: move the active window inside this workspace.
if [[ $(jq -r '.floating' <<< "$active") == true ]]; then
    read -r width height < <(hyprctl monitors -j | jq -r --argjson id "$monitor_id" \
        '.[] | select(.id == $id) | "\(.width) \(.height)"')
    x=0 y=0
    case "$direction" in
        left) x=$(awk -v n="$width" 'BEGIN {printf "%.0f", -n*0.15}') ;;
        right) x=$(awk -v n="$width" 'BEGIN {printf "%.0f", n*0.15}') ;;
        up) y=$(awk -v n="$height" 'BEGIN {printf "%.0f", -n*0.15}') ;;
        down) y=$(awk -v n="$height" 'BEGIN {printf "%.0f", n*0.15}') ;;
    esac
    hyprctl dispatch "hl.dsp.window.move({ x = $x, y = $y, relative = true })" >/dev/null
else
    # A simple two-tile pair swaps slots along its axis or reorients across it.
    # Outward-edge moves retain native monitor behavior.
    if [[ $mode == direction ]] && pair=$(hyprctl clients -j 2>/dev/null | jq -r \
        --argjson active "$active" --arg direction "$direction" '
        def rectangle:
            (.at | type) == "array" and (.size | type) == "array"
            and (.at | length) == 2 and (.size | length) == 2
            and all(.at[]; type == "number")
            and all(.size[]; type == "number" and . > 0);
        [.[] | select(.workspace.id == $active.workspace.id
            and .mapped == true and .hidden == false and .floating == false)] as $tiles |
        if ($tiles | length) != 2
            or ($active.address | type) != "string"
            or ($active.workspace.id | type) != "number"
            or (all($tiles[]; .fullscreen == 0 and (.grouped | type) == "array"
                and (.grouped | length) == 0 and rectangle) | not)
        then empty else
            [$tiles[] | select(.address == $active.address)] as $focused |
            if ($focused | length) != 1 or ($active.address | test("^0x[0-9a-fA-F]+$") | not)
            then empty else
                $focused[0] as $me |
                ($tiles[] | select(.address != $active.address)) as $other |
                ($me.at[0] < $other.at[0] + $other.size[0]
                    and $other.at[0] < $me.at[0] + $me.size[0]) as $x_overlap |
                ($me.at[1] < $other.at[1] + $other.size[1]
                    and $other.at[1] < $me.at[1] + $me.size[1]) as $y_overlap |
                (if $y_overlap and ($x_overlap | not)
                    then {first: ($me.at[0] < $other.at[0]),
                        perpendicular: ($direction == "up" or $direction == "down")}
                 elif $x_overlap and ($y_overlap | not)
                    then {first: ($me.at[1] < $other.at[1]),
                        perpendicular: ($direction == "left" or $direction == "right")}
                 else empty end) as $layout |
                ($direction == "up" or $direction == "left") as $want_first |
                (if $layout.perpendicular then
                    if $layout.first == $want_first then "toggle" else "toggle_swap" end
                 elif $layout.first != $want_first then "swap"
                 else empty end) as $order |
                [$me.address, $me.workspace.id, $order] | @tsv
            end
        end' 2>/dev/null) && [[ -n $pair ]]; then
        IFS=$'\t' read -r address workspace order <<< "$pair"
        case "$order" in
            toggle) actions='hl.dispatch(hl.dsp.layout("togglesplit"));' ;;
            swap) actions='hl.dispatch(hl.dsp.layout("swapsplit"));' ;;
            toggle_swap) actions='hl.dispatch(hl.dsp.layout("togglesplit")); hl.dispatch(hl.dsp.layout("swapsplit"));' ;;
        esac
        # Swapping without reinsertion preserves the divider's split ratio.
        # One callback keeps the operations together and ignores stale focus.
        hyprctl dispatch "function() local w = hl.get_active_window(); if w ~= nil and w.address == \"$address\" and w.workspace.id == $workspace then $actions end end" >/dev/null
        exit 0
    fi
    hyprctl dispatch "hl.dsp.window.move({ direction = \"$code\" })" >/dev/null
fi
