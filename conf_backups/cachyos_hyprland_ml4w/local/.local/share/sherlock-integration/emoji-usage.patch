diff --git a/src/launcher/emoji_picker/usage.rs b/src/launcher/emoji_picker/usage.rs
new file mode 100644
index 0000000..949ad7d
--- /dev/null
+++ b/src/launcher/emoji_picker/usage.rs
@@ -0,0 +1,235 @@
+use std::{cmp::Reverse, collections::HashMap, fs, io, os::unix::fs::OpenOptionsExt, path::Path};
+
+use serde::{Deserialize, Serialize};
+
+use crate::g_subclasses::emoji_item::EmojiRaw;
+
+#[derive(Default, Deserialize, Serialize)]
+struct History {
+    entries: HashMap<String, (u64, u64)>,
+}
+
+impl History {
+    fn load(path: &Path) -> Self {
+        fs::read(path)
+            .ok()
+            .and_then(|data| serde_json::from_slice(&data).ok())
+            .unwrap_or_default()
+    }
+
+    fn order(&self, emojis: &mut [EmojiRaw]) {
+        if !self.entries.is_empty() {
+            emojis.sort_by_cached_key(|emoji| {
+                Reverse(
+                    self.entries
+                        .get(&emoji.emoji())
+                        .copied()
+                        .unwrap_or_default(),
+                )
+            });
+        }
+    }
+
+    fn record(&mut self, emoji: &str) {
+        let sequence = self
+            .entries
+            .values()
+            .map(|entry| entry.1)
+            .max()
+            .unwrap_or(0)
+            .saturating_add(1);
+        let entry = self.entries.entry(emoji.to_string()).or_default();
+        entry.0 = entry.0.saturating_add(1);
+        entry.1 = sequence;
+    }
+
+    fn save(&self, path: &Path) -> io::Result<()> {
+        let temporary = path.with_extension(format!("tmp-{}", std::process::id()));
+        let file = fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .open(&temporary)?;
+        let result = serde_json::to_writer(&file, self)
+            .map_err(io::Error::other)
+            .and_then(|()| fs::rename(&temporary, path));
+        if result.is_err() {
+            let _ = fs::remove_file(temporary);
+        }
+        result
+    }
+}
+
+pub(super) fn order(emojis: &mut [EmojiRaw]) {
+    if let Ok(directory) = crate::utils::paths::get_data_dir() {
+        History::load(&directory.join("emoji-usage.json")).order(emojis);
+    }
+}
+
+pub(crate) fn remember(emoji: &str) {
+    if let Ok(directory) = crate::utils::paths::get_data_dir() {
+        let path = directory.join("emoji-usage.json");
+        let mut history = History::load(&path);
+        history.record(emoji);
+        let _ = history.save(&path);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{
+        fs,
+        path::PathBuf,
+        sync::atomic::{AtomicUsize, Ordering},
+    };
+
+    static NEXT: AtomicUsize = AtomicUsize::new(0);
+
+    struct Fixture(PathBuf);
+
+    impl Fixture {
+        fn new() -> Self {
+            let path = PathBuf::from("/tmp/opencode").join(format!(
+                "sherlock-emoji-test-{}-{}",
+                std::process::id(),
+                NEXT.fetch_add(1, Ordering::Relaxed)
+            ));
+            fs::create_dir(&path).unwrap();
+            Self(path)
+        }
+
+        fn file(&self) -> PathBuf {
+            self.0.join("emoji-usage.json")
+        }
+    }
+
+    impl Drop for Fixture {
+        fn drop(&mut self) {
+            fs::remove_dir_all(&self.0).unwrap();
+        }
+    }
+
+    fn emojis() -> Vec<EmojiRaw> {
+        serde_json::from_value(serde_json::json!([
+            {"emoji": "😀", "name": "Grinning", "skin": 0},
+            {"emoji": "🚀", "name": "Rocket", "skin": 0},
+            {"emoji": "❤️", "name": "Heart", "skin": 0},
+            {"emoji": "👍{skin_tone}", "name": "Thumbs Up", "skin": 1}
+        ]))
+        .unwrap()
+    }
+
+    fn ordered(history: &History) -> Vec<String> {
+        let mut items = emojis();
+        history.order(&mut items);
+        items.iter().map(EmojiRaw::emoji).collect()
+    }
+
+    #[test]
+    fn frequency_beats_a_more_recent_selection() {
+        let history = History {
+            entries: HashMap::from([("🚀".into(), (3, 1)), ("❤️".into(), (2, 99))]),
+        };
+        assert_eq!(ordered(&history), ["🚀", "❤️", "😀", "👍{skin_tone}"]);
+    }
+
+    #[test]
+    fn most_recent_selection_breaks_equal_count_ties() {
+        let history = History {
+            entries: HashMap::from([("🚀".into(), (2, 1)), ("❤️".into(), (2, 2))]),
+        };
+        assert_eq!(ordered(&history), ["❤️", "🚀", "😀", "👍{skin_tone}"]);
+    }
+
+    #[test]
+    fn unused_and_exactly_tied_emojis_keep_original_order() {
+        assert_eq!(
+            ordered(&History::default()),
+            ["😀", "🚀", "❤️", "👍{skin_tone}"]
+        );
+        let history = History {
+            entries: HashMap::from([("🚀".into(), (1, 1)), ("❤️".into(), (1, 1))]),
+        };
+        assert_eq!(ordered(&history), ["🚀", "❤️", "😀", "👍{skin_tone}"]);
+    }
+
+    #[test]
+    fn used_emoji_beyond_the_original_filter_limit_reaches_first_position() {
+        let mut items: Vec<EmojiRaw> =
+            serde_json::from_str(include_str!("../../../resources/emojies.json")).unwrap();
+        assert!(items.len() > 77);
+        let last = items.last().unwrap().emoji();
+        let history = History {
+            entries: HashMap::from([(last.clone(), (1, 1))]),
+        };
+        history.order(&mut items);
+        assert_eq!(items[0].emoji(), last);
+    }
+
+    #[test]
+    fn selections_increment_once_and_use_monotonic_recency() {
+        let mut history = History::default();
+        history.record("🚀");
+        history.record("🚀");
+        history.record("👍{skin_tone}");
+        assert_eq!(history.entries.get("🚀"), Some(&(2, 2)));
+        assert_eq!(history.entries.get("👍{skin_tone}"), Some(&(1, 3)));
+    }
+
+    #[test]
+    fn usage_survives_reopen_without_recording_browsing() {
+        let fixture = Fixture::new();
+        let mut history = History::default();
+        history.record("🚀");
+        history.save(&fixture.file()).unwrap();
+        let before = fs::read(fixture.file()).unwrap();
+        let reopened = History::load(&fixture.file());
+        assert_eq!(ordered(&reopened), ["🚀", "😀", "❤️", "👍{skin_tone}"]);
+        assert_eq!(reopened.entries.get("🚀"), Some(&(1, 1)));
+        assert_eq!(fs::read(fixture.file()).unwrap(), before);
+    }
+
+    #[test]
+    fn missing_and_corrupt_history_preserve_default_order() {
+        let fixture = Fixture::new();
+        assert_eq!(
+            ordered(&History::load(&fixture.file())),
+            ["😀", "🚀", "❤️", "👍{skin_tone}"]
+        );
+        assert!(!fixture.file().exists());
+        for data in [
+            b"broken json".as_slice(),
+            br#"{"entries":{"x":[-1,2]}}"#,
+            br#"{"entries":{"x":[1]}}"#,
+        ] {
+            fs::write(fixture.file(), data).unwrap();
+            assert_eq!(
+                ordered(&History::load(&fixture.file())),
+                ["😀", "🚀", "❤️", "👍{skin_tone}"]
+            );
+        }
+    }
+
+    #[test]
+    fn failed_persistence_leaves_existing_history_intact() {
+        let fixture = Fixture::new();
+        let path = fixture.0.join("blocked");
+        fs::create_dir(&path).unwrap();
+        fs::write(path.join("keep"), b"untouched").unwrap();
+        assert!(History::default().save(&path).is_err());
+        assert_eq!(fs::read(path.join("keep")).unwrap(), b"untouched");
+    }
+
+    #[test]
+    fn successful_persistence_is_private_and_leaves_no_temporary_file() {
+        use std::os::unix::fs::PermissionsExt;
+        let fixture = Fixture::new();
+        History::default().save(&fixture.file()).unwrap();
+        assert_eq!(
+            fs::metadata(fixture.file()).unwrap().permissions().mode() & 0o777,
+            0o600
+        );
+        assert_eq!(fs::read_dir(&fixture.0).unwrap().count(), 1);
+    }
+}
