#!/usr/bin/env bash

# Default variables
CACHE_FOLDER="$HOME/.cache/ml4w/hyprland-dotfiles"
CACHE_FILE="$CACHE_FOLDER/current_wallpaper"
DEFAULT_WALLPAPER="$HOME/.config/ml4w/wallpapers/default.jpg"
AWWW_DAEMON_VERSION="$(awww-daemon --version 2>/dev/null | awk '{ print $2 }')"
AWWW_CACHE_FOLDER="${XDG_CACHE_HOME:-"$HOME/.cache"}/awww/$AWWW_DAEMON_VERSION"

# Colors for UI
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# --- UI Functions (Redirected to stderr) ---
info() { echo -e "${GREEN}[INFO]${NC} $1" >&2; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1" >&2; }
error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

# Ensure that cache folder exists
mkdir -p $HOME/.cache

# Set Wallpaper
mkdir -p $CACHE_FOLDER
if [ ! -f $CACHE_FILE ]; then
    touch $CACHE_FILE
    echo "$DEFAULT_WALLPAPER" > "$CACHE_FILE"
    info "Cache file created"
fi

# Start nmapplet
nm-applet --indicator &

# Quickshell reads its icon theme from QS_ICON_THEME, not from GTK. Hyprland
# normally exports it (conf/environment.lua); fall back to reading the GTK
# settings here so a manual run of this script still themes the dock icons.
if [ -z "$QS_ICON_THEME" ]; then
    GTK_SETTINGS="$HOME/.config/gtk-3.0/settings.ini"
    if [ -f "$GTK_SETTINGS" ]; then
        ICON_THEME="$(grep 'gtk-icon-theme-name' "$GTK_SETTINGS" | sed 's/.*\s*=\s*//')"
        [ -n "$ICON_THEME" ] && export QS_ICON_THEME="$ICON_THEME"
    fi
fi
info "Quickshell icon theme: ${QS_ICON_THEME:-<unset>}"

# Kill any existing qs instances
killall qs 2>/dev/null || true

# Start Quickshell first
info "Starting Quickshell"
qs &

# Wait for qs process to be ready, then let IPC initialize
info "Waiting for Quickshell..."
timeout=15
elapsed=0
until pgrep -x qs >/dev/null 2>&1; do
    sleep 0.2
    elapsed=$((elapsed + 1))
    if [ $elapsed -ge $((timeout * 5)) ]; then
        warn "Quickshell did not start within ${timeout}s"
        break
    fi
done
sleep 0.5
info "Quickshell ready"

# Restore first, then resume slideshow in the same background job. This avoids
# racing two updates while keeping login non-blocking. The global theming
# preference is honored by ml4w-wallpaper; saved colors load separately in QML.
(
if [[ -z $(find "$AWWW_CACHE_FOLDER" -mindepth 1 -maxdepth 1 -type f -print -quit 2>/dev/null) ]]; then
    info "Set wallpaper to cache file $(cat $CACHE_FILE)"
    ~/.config/ml4w/scripts/ml4w-wallpaper "$(cat $CACHE_FILE)"
else
    info "awww cache present, applying theming only for $(cat $CACHE_FILE)"
    ~/.config/ml4w/scripts/ml4w-wallpaper "$(cat $CACHE_FILE)" --skip-wallpaper
fi

# BEGIN slideshow resume
# Resume the wallpaper slideshow when enabled. The --status guard means a
# second login (or a manual start racing autostart) never spawns a duplicate
# loop, and a stale pid left by a reboot is replaced inside the script.
slideshow_setting="$(cat "$HOME/.config/ml4w/settings/wallpaper-slideshow" 2>/dev/null || echo false)"
slideshow_setting=$(printf '%s' "$slideshow_setting" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
if [[ "$slideshow_setting" == "true" ]]; then
    if ~/.config/ml4w/scripts/ml4w-wallpaper-automation --status >/dev/null 2>&1; then
        info "Wallpaper slideshow already running"
    else
        info "Resuming wallpaper slideshow"
        ~/.config/ml4w/scripts/ml4w-wallpaper-automation --start >/dev/null 2>&1 &
        disown
    fi
fi
# END slideshow resume
) &

# Start ML4W Settings App — LAZY-START: launched on first open via
# ~/.local/bin/qs-lazy-toggle (Sidebar/Welcome buttons), not at boot.
# info "Starting ML4W Dotfiles Settings"
# PROFILE="com.ml4w.dotfiles" qs -p $HOME/.local/share/ml4w-dotfiles-settings/quickshell &
# info "ML4W Dotfiles Settings started"

# Start Quickshell Overview — LAZY-START: launched on first ALT+Tab/SUPER+Tab
# via ~/.local/bin/qs-lazy-toggle, not at boot.
# info "Starting Quickshell Overview"
# qs -p $HOME/.local/share/quickshell-overview &
# info "Quickshell Overview started"

# Start ML4W Dock
info "Starting ML4W Dock"
ml4w-dock start &
info "ML4W Dock started"

# Start ML4W Welcome App
info "Starting ML4W Welcome App"
if [ ! -f $HOME/.cache/ml4w-welcome-autostart ]; then
    timeout=30
    count=0
    sleep 1
    until qs ipc call welcome toggle >/dev/null 2>&1; do
        (( count++ ))
        if (( count >= timeout )); then
            warn "Welcome IPC not available after ${timeout}s"
            break
        fi
        sleep 1
    done
    info "ML4W Welcome started"
else
    info "ML4W Welcome disabled"
fi
