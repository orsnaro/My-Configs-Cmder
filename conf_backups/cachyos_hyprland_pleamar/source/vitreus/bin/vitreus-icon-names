#!/usr/bin/env python3
"""Print the current GTK icon theme's icon names, one per line.

The shell uses this once at startup so a notification whose icon name is not
actually in the theme can fall back to its bell instead of drawing a blank tile.
"""
from __future__ import annotations

import sys

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gtk


def main() -> int:
    theme = Gtk.IconTheme.new()
    for name in theme.get_icon_names():
        if name:
            print(name)
    return 0


if __name__ == "__main__":
    sys.exit(main())
