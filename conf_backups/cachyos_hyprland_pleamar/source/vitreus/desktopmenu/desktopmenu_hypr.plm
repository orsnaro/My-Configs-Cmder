language 0.1

//  HYPRLAND ONLY: a right press on the bare wallpaper opens the desktop editor (desktopedit/). Under pleamar-wm the window manager's `desk` facts do that directly (see vitreus.luau),
//  so this scene is not used there. There is no menu any more: this is just the surface that hears the press.

scene DesktopMenu {
    surface { size: full, full; anchor: top_left; margin: 0; level: background; screens: each max 4; reserve: -1; keyboard: none }

    permissions { run: "pleamar", "sh" }

    fact mmon = 0              // which monitor it was pressed on
    event edit_req ->

    //  (A square as big as the longest side of any monitor: `screen.width` and `screen.height` are those of the first one.)
    zone box wall { from: 0, 0; size: 2560, 2560 }
    on press right wall { mmon = screen.index; emit edit_req }
}
