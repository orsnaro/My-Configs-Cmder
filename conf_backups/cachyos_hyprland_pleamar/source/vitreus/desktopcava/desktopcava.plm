language 0.1
import "../palette.plm"

//  The desktop audio visualiser: what is playing, drawn by cava, on the bottom layer (above the wallpaper, under every window). Six styles (bars, mirror, wave, line, dots, radial),
//  five places (the bottom, the top, the left and right edges, the middle), three sizes and four looks (the shell's glass, the accent, light, or warm).
//  It listens only while it is shown, and fades out by itself while nothing plays.
//
//  Turn it on or off with   pleamar --say desktopcava "fact shown true"   (or false); Settings > Widgets has the switch and the rest, and so has the desktop's right-click menu.
//  Its settings are kept in desktopcava.json, in ~/.local/share/pleamar/desktopcava (see desktopcava.luau).

scene DesktopCava {
    surface { size: full, full; anchor: top_left; margin: 0; level: bottom; screens: each; reserve: -1; rate: 60 }

    permissions {
        services: "files", "files.write"
        run: "cava", "printenv", "pleamar", "hyprctl"
    }

    fact shown = false     // the logic sets it from desktopcava.json
    fact sty = 0           // 0 bars, 1 mirror, 2 wave, 3 line, 4 dots, 5 radial
    fact pos = 0           // 0 bottom, 1 top, 2 left, 3 right, 4 middle
    fact siz = 1           // 0 small, 1 medium, 2 large
    fact cm = 0            // 0 glass, 1 accent, 2 light, 3 warm
    fact live = false      // something is playing (the logic: the bars have been above the floor lately)
    fact demo = false      // for finding faults: made-up bars instead of cava's (`pleamar --say desktopcava "fact demo true"`)
    fact obs = false       // Vitreus has its glass off: flat obsidian (Vitreus says so with `fact obs true`)

    text mon_pick = "all"  // which monitor shows it: "all", or a monitor's name; Settings sets it, and the logic keeps it in desktopcava.json
    fact mon = 0           // the copy of the scene that is on the chosen monitor (the scene has a copy on each monitor; only that one draws)
    fact allm = true       // every monitor draws it (mon_pick is "all", or names a monitor that is not plugged in)
    //  What each copy's monitor measures, up to four, in the order of the copies (`screen.index`); the logic asks `hyprctl` and `describe` (`screen.width` is 0 in a copy made for each monitor).
    fact m0w = 0
    fact m0h = 0
    fact m1w = 0
    fact m1h = 0
    fact m2w = 0
    fact m2h = 0
    fact m3w = 0
    fact m3h = 0

    model bars max 48 { v: number }     // cava's bars, 0..1
    model pts max 96 { v: number }      // the same, smoothed between, for the wave and the line

    prop sh = 0 ~calm
    follow sh = if(shown, 1, 0)
    prop lv = 0 ~calm
    follow lv = if(live, 1, 0)
    prop ob = 0 ~calm
    follow ob = if(obs or look == 1 or look == 2, 1, 0)
    fact look = 0          // the shell's theme (Vitreus says so): 0 Glass, 1 Retro, 2 UwU; the last two draw the bars as plastic, like the bar (outline, hard shadow)
    prop pl = 0 ~calm
    follow pl = if(look == 1 or look == 2, 1, 0)
    prop uk = 0 ~calm
    follow uk = if(look == 2, 1, 0)
    let mi = clamp(screen.index, 0, 3)
    let here = if(allm or mi == mon, 1, 0)
    let vis = sh * lv * here

    //  Where it goes: a frame of `len` by `thk` pixels centred on (cx, cy), turned so that its bottom is against the edge it sits at. Everything below is drawn in
    //  that frame as if it sat at the bottom of the screen; the group at the end turns it.
    let gm = 40
    let scw = pick(mi, m0w, m1w, m2w, m3w)        // what this copy's monitor measures, and so the places below are right for a tall monitor as well as a wide one
    let sch = pick(mi, m0h, m1h, m2h, m3h)
    let along = if(pos == 2 or pos == 3, sch, scw)
    let len = (along - 2 * gm) * pick(siz, 0.4, 0.6, 0.85)
    let thk = pick(siz, 110, 200, 320)
    let cx = pick(pos, scw / 2, scw / 2, gm + thk / 2, scw - gm - thk / 2, scw / 2)
    let cy = pick(pos, sch - gm - thk / 2, gm + thk / 2, sch / 2, sch / 2, sch / 2)
    let ang = pick(pos, 0, 180, 90, -90, 0)
    let x0 = cx - len / 2
    let y0 = cy + thk / 2

    let slot = len / 48
    let bw = max(2, slot * 0.62)
    let ps = len / 96
    let rr = thk * 0.3
    let rw = max(2, rr * 0.13)
    let gl = if(cm == 0 and ob < 0.5, 1, 0)
    //  A shape inside a body ignores `show`, so what is not in the style in use is put out of the screen (as the clock's digits are).
    let o0 = if(sty == 0, 0, 30000)
    let o1 = if(sty == 1, 0, 30000)
    let o2 = if(sty == 2, 0, 30000)
    let o3 = if(sty == 3, 0, 30000)
    let o4 = if(sty == 4, 0, 30000)
    let o5 = if(sty == 5, 0, 30000)

    //  One body for every look: with the glass on it is the shell's glass (as the system monitor's, flat obsidian when Vitreus has its glass off), otherwise a plain
    //  fill in the accent, the light or the warm colour. The shapes are channels of it, drawn in the frame above as if it sat at the bottom of the screen; the
    //  group turns the frame to its edge. (Written by gen.py: a body takes no `repeat`.)
    group {
        pivot: cx, cy
        rotate: ang * 1deg
        show: vis > 0.01
        body {
            color: if(cm == 0, mix(tint, mix(mix(tint, #000000, 0.7), ink, 0.3), ob * (1 - pl)), if(cm == 1, mint, if(cm == 2, ink, alert)))
            glass: gl
            lens: false
            rim: 70% * gl
            shine: 0, 0
            border: (2 + 1.2 * uk) * pl, deep
            shadow: 4 * pl, 6 - pl, 18 * (1 - pl), 30% + 15% * ob * (1 - gl) + 40% * pl, mix(mix(#000000, deep, pl), #ff6ec7, 0.75 * uk)
            opacity: vis * if(cm == 0 or pl > 0.5, 100%, 85%)
            box { at: x0 + 0.5 * slot + o0, y0 - max(bw, clamp(bars.0.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.0.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 0.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.0.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 1.5 * slot + o0, y0 - max(bw, clamp(bars.1.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.1.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 1.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.1.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 2.5 * slot + o0, y0 - max(bw, clamp(bars.2.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.2.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 2.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.2.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 3.5 * slot + o0, y0 - max(bw, clamp(bars.3.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.3.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 3.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.3.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 4.5 * slot + o0, y0 - max(bw, clamp(bars.4.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.4.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 4.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.4.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 5.5 * slot + o0, y0 - max(bw, clamp(bars.5.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.5.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 5.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.5.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 6.5 * slot + o0, y0 - max(bw, clamp(bars.6.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.6.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 6.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.6.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 7.5 * slot + o0, y0 - max(bw, clamp(bars.7.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.7.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 7.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.7.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 8.5 * slot + o0, y0 - max(bw, clamp(bars.8.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.8.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 8.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.8.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 9.5 * slot + o0, y0 - max(bw, clamp(bars.9.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.9.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 9.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.9.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 10.5 * slot + o0, y0 - max(bw, clamp(bars.10.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.10.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 10.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.10.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 11.5 * slot + o0, y0 - max(bw, clamp(bars.11.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.11.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 11.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.11.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 12.5 * slot + o0, y0 - max(bw, clamp(bars.12.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.12.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 12.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.12.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 13.5 * slot + o0, y0 - max(bw, clamp(bars.13.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.13.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 13.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.13.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 14.5 * slot + o0, y0 - max(bw, clamp(bars.14.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.14.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 14.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.14.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 15.5 * slot + o0, y0 - max(bw, clamp(bars.15.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.15.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 15.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.15.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 16.5 * slot + o0, y0 - max(bw, clamp(bars.16.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.16.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 16.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.16.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 17.5 * slot + o0, y0 - max(bw, clamp(bars.17.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.17.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 17.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.17.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 18.5 * slot + o0, y0 - max(bw, clamp(bars.18.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.18.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 18.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.18.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 19.5 * slot + o0, y0 - max(bw, clamp(bars.19.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.19.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 19.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.19.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 20.5 * slot + o0, y0 - max(bw, clamp(bars.20.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.20.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 20.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.20.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 21.5 * slot + o0, y0 - max(bw, clamp(bars.21.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.21.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 21.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.21.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 22.5 * slot + o0, y0 - max(bw, clamp(bars.22.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.22.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 22.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.22.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 23.5 * slot + o0, y0 - max(bw, clamp(bars.23.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.23.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 23.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.23.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 24.5 * slot + o0, y0 - max(bw, clamp(bars.24.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.24.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 24.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.24.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 25.5 * slot + o0, y0 - max(bw, clamp(bars.25.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.25.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 25.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.25.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 26.5 * slot + o0, y0 - max(bw, clamp(bars.26.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.26.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 26.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.26.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 27.5 * slot + o0, y0 - max(bw, clamp(bars.27.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.27.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 27.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.27.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 28.5 * slot + o0, y0 - max(bw, clamp(bars.28.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.28.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 28.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.28.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 29.5 * slot + o0, y0 - max(bw, clamp(bars.29.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.29.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 29.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.29.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 30.5 * slot + o0, y0 - max(bw, clamp(bars.30.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.30.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 30.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.30.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 31.5 * slot + o0, y0 - max(bw, clamp(bars.31.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.31.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 31.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.31.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 32.5 * slot + o0, y0 - max(bw, clamp(bars.32.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.32.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 32.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.32.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 33.5 * slot + o0, y0 - max(bw, clamp(bars.33.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.33.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 33.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.33.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 34.5 * slot + o0, y0 - max(bw, clamp(bars.34.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.34.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 34.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.34.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 35.5 * slot + o0, y0 - max(bw, clamp(bars.35.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.35.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 35.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.35.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 36.5 * slot + o0, y0 - max(bw, clamp(bars.36.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.36.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 36.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.36.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 37.5 * slot + o0, y0 - max(bw, clamp(bars.37.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.37.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 37.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.37.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 38.5 * slot + o0, y0 - max(bw, clamp(bars.38.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.38.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 38.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.38.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 39.5 * slot + o0, y0 - max(bw, clamp(bars.39.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.39.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 39.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.39.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 40.5 * slot + o0, y0 - max(bw, clamp(bars.40.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.40.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 40.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.40.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 41.5 * slot + o0, y0 - max(bw, clamp(bars.41.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.41.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 41.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.41.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 42.5 * slot + o0, y0 - max(bw, clamp(bars.42.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.42.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 42.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.42.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 43.5 * slot + o0, y0 - max(bw, clamp(bars.43.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.43.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 43.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.43.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 44.5 * slot + o0, y0 - max(bw, clamp(bars.44.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.44.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 44.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.44.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 45.5 * slot + o0, y0 - max(bw, clamp(bars.45.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.45.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 45.5 * slot + o1, cy; size: bw, max(bw, clamp(bars.45.v, 0, 1) * thk); corner: bw / 2 }
            box { at: x0 + 46.5 * slot + o0, y0 - max(bw, clamp(bars.46.v, 0, 1) * thk) / 2; size: bw, max(bw, clamp(bars.46.v, 0, 1) * thk); corner: bw / 2 }
