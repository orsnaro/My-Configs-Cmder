part KeybindsKeys {
    //  Generated: every key the Keybinds page can record, bare and with each set of modifiers. A press sends `kb_press(mask * 100 + the key's place in KEYS)`
    //  (logic/keybinds.luau). Shift alone only counts on keys that write nothing (Shift+a is a capital A, which the key rule for `a` already says).
    //  The digits are missing: a rule cannot name them (`on key 1` is not a name), so a bind on a digit has to be written in the file.
    //  KEYS: a b c d e f g h i j k l m n o p q r s t u v w x y z F1 F2 F3 F4 F5 F6 F7 F8 F9 F10 F11 F12 space Return Tab Print BackSpace Delete Insert Home End Prior Next Left Right Up Down comma period slash semicolon apostrophe bracketleft bracketright backslash minus equal grave

    on key a while panel == settings and set_page == pg_keys and kb_cap { emit kb_press(0) }
    on key Super+a while panel == settings and set_page == pg_keys and kb_cap { emit kb_press(100) }
    on key Ctrl+a while panel == settings and set_page == pg_keys and kb_cap { emit kb_press(400) }
    on key Alt+a while panel == settings and set_page == pg_keys and kb_cap { emit kb_press(800) }
    on key Super+Shift+a while panel == settings and set_page == pg_keys and kb_cap { emit kb_press(300) }
    on key Ctrl+Shift+a while panel == settings and set_page == pg_keys and kb_cap { emit kb_press(600) }
    on key Alt+Shift+a while panel == settings and set_page == pg_keys and kb_cap { emit kb_press(1000) }
    on key Ctrl+Alt+a while panel == settings and set_page == pg_keys and kb_cap { emit kb_press(1200) }
    on key Super+Ctrl+a while panel == settings and set_page == pg_keys and kb_cap { emit kb_press(500) }
    on key Super+Alt+a while panel == settings and set_page == pg_keys and kb_cap { emit kb_press(900) }
    on key b while panel == settings and set_page == pg_keys and kb_cap { emit kb_press(1) }
    on key Super+b while panel == settings and set_page == pg_keys and kb_cap { emit kb_press(101) }
