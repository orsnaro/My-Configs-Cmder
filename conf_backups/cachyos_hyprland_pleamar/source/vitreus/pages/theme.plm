part Theme {
        //  The Theme page: four looks (logic: `theme_pick`). Glass: liquid glass in the colours Iris reads off the wallpaper. Retro: moulded plastic in its own palette. UwU: candy-coloured plastic with cat ears, stars, hearts and paws. Cyber: near-black glass with neon HUD marks, digital rain and terminal readouts.
        //  The lock screen, the window borders and the rest follow whichever is chosen.
        group {
            show: set_pgp > 0.01
            opacity: set_pgp
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 16 * pu + 0.5); text "Theme" { at: floor(spx + 14 * pu + 0.5), floor(sby + 16 * pu + 0.5); anchor: left center; size: 17.5; weight: 700; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 16 * pu + 0.5); text "Changes apply right away." { at: floor(spx + 424 * pu + 0.5), floor(sby + 16 * pu + 0.5); anchor: right center; size: 13.5; color: faint; opacity: 80%; family: "Space Grotesk" } }
            //  The looks, as four cards: each shows its five colours as broad slanted stripes, fading from the panel colour on the left, where the words are.
            //  The card the looks and the font sit in, like the ones under it.
            body { color: mix(obsidian, ink, (6%) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 121 * pu; size: 438 * pu, 174 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 121 * pu; size: 438 * pu, 174 * pu; corner: 14 * pu; color: ink; opacity: (6%) * (1 - obs) }
            //  Glass
            group {
                clip inset 0 box { at: spx + 62 * pu, sby + 84 * pu; size: 96 * pu, 76 * pu; corner: 14 * pu }
                body { gradient: spx + 62 * pu - 48 * pu, sby + 84 * pu to spx + 62 * pu + 48 * pu, sby + 84 * pu, mix(wcol.tint, mix(#000000, tint, pk), 0.66), mix(wcol.tint, mix(#000000, tint, pk), 0.54) 55%, mix(wcol.tint, mix(#000000, tint, pk), 0.1); path { at: spx + 62 * pu, sby + 84 * pu; move -72.4 * pu, -38 * pu; line -44.3 * pu, -38 * pu; line -65 * pu, 38 * pu; line -93 * pu, 38 * pu; close } }
                body { gradient: spx + 62 * pu - 48 * pu, sby + 84 * pu to spx + 62 * pu + 48 * pu, sby + 84 * pu, mix(wcol.panel, mix(#000000, tint, pk), 0.66), mix(wcol.panel, mix(#000000, tint, pk), 0.54) 55%, mix(wcol.panel, mix(#000000, tint, pk), 0.1); path { at: spx + 62 * pu, sby + 84 * pu; move -47.3 * pu, -38 * pu; line -19.2 * pu, -38 * pu; line -39.9 * pu, 38 * pu; line -67.9 * pu, 38 * pu; close } }
                body { gradient: spx + 62 * pu - 48 * pu, sby + 84 * pu to spx + 62 * pu + 48 * pu, sby + 84 * pu, mix(wcol.ink, mix(#000000, tint, pk), 0.66), mix(wcol.ink, mix(#000000, tint, pk), 0.54) 55%, mix(wcol.ink, mix(#000000, tint, pk), 0.1); path { at: spx + 62 * pu, sby + 84 * pu; move -22.2 * pu, -38 * pu; line 5.9 * pu, -38 * pu; line -14.8 * pu, 38 * pu; line -42.8 * pu, 38 * pu; close } }
                body { gradient: spx + 62 * pu - 48 * pu, sby + 84 * pu to spx + 62 * pu + 48 * pu, sby + 84 * pu, mix(wcol.mint, mix(#000000, tint, pk), 0.66), mix(wcol.mint, mix(#000000, tint, pk), 0.54) 55%, mix(wcol.mint, mix(#000000, tint, pk), 0.1); path { at: spx + 62 * pu, sby + 84 * pu; move 3 * pu, -38 * pu; line 31 * pu, -38 * pu; line 10.3 * pu, 38 * pu; line -17.7 * pu, 38 * pu; close } }
                body { gradient: spx + 62 * pu - 48 * pu, sby + 84 * pu to spx + 62 * pu + 48 * pu, sby + 84 * pu, mix(wcol.alert, mix(#000000, tint, pk), 0.66), mix(wcol.alert, mix(#000000, tint, pk), 0.54) 55%, mix(wcol.alert, mix(#000000, tint, pk), 0.1); path { at: spx + 62 * pu, sby + 84 * pu; move 28.1 * pu, -38 * pu; line 56.1 * pu, -38 * pu; line 35.4 * pu, 38 * pu; line 7.4 * pu, 38 * pu; close } }
                box { at: spx + 62 * pu, sby + 84 * pu; size: 96 * pu, 76 * pu; color: #ffffff; opacity: 8% * theme_hit.0.hover }
            }
            box { at: spx + 62 * pu, sby + 84 * pu; size: 96 * pu, 76 * pu; corner: 14 * pu; stroke: 1.6 * pu; color: mint; opacity: if(theme_sel == 0, 90%, 0) }
            group { scale: rs; pivot: floor(spx + 62 * pu - 40 * pu + 0.5), floor(sby + 84 * pu - 17 * pu + 0.5); text "Glass" { at: floor(spx + 62 * pu - 40 * pu + 0.5), floor(sby + 84 * pu - 17 * pu + 0.5); anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 62 * pu - 40 * pu + 0.5), floor(sby + 84 * pu + 4 * pu + 0.5); text "Wallpaper" { at: floor(spx + 62 * pu - 40 * pu + 0.5), floor(sby + 84 * pu + 4 * pu + 0.5); anchor: left center; size: 12; weight: 500; width: (80 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            ellipse { at: spx + 62 * pu + -34 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; color: wcol.tint }
            ellipse { at: spx + 62 * pu + -34 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 62 * pu + -17 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; color: wcol.panel }
            ellipse { at: spx + 62 * pu + -17 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 62 * pu + 0 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; color: wcol.ink }
            ellipse { at: spx + 62 * pu + 0 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 62 * pu + 17 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; color: wcol.mint }
            ellipse { at: spx + 62 * pu + 17 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 62 * pu + 34 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; color: wcol.alert }
            ellipse { at: spx + 62 * pu + 34 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 62 * pu + 36 * pu, sby + 84 * pu - 25 * pu; radius: 7 * pu; color: mint; opacity: if(theme_sel == 0, 100%, 0) }
            path { at: spx + 62 * pu + 36 * pu, sby + 84 * pu - 25 * pu; stroke: 1.5 * pu; color: onmint; opacity: if(theme_sel == 0, 100%, 0); move -3 * pu, 0; line -0.9 * pu, 2.5 * pu; line 3.2 * pu, -2.7 * pu }
            zone box theme_hit.0 { at: spx + 62 * pu, sby + 84 * pu; size: 96 * pu, 76 * pu; corner: 14 * pu; cursor: pointer; label: "Glass theme" }
            on press theme_hit.0 { emit theme_pick(0) }
            //  Retro
            group {
                clip inset 0 box { at: spx + 167 * pu, sby + 84 * pu; size: 96 * pu, 76 * pu; corner: 14 * pu }
                body { gradient: spx + 167 * pu - 48 * pu, sby + 84 * pu to spx + 167 * pu + 48 * pu, sby + 84 * pu, mix(#d6d0bd, mix(#000000, tint, pk), 0.66), mix(#d6d0bd, mix(#000000, tint, pk), 0.54) 55%, mix(#d6d0bd, mix(#000000, tint, pk), 0.1); path { at: spx + 167 * pu, sby + 84 * pu; move -72.4 * pu, -38 * pu; line -44.3 * pu, -38 * pu; line -65 * pu, 38 * pu; line -93 * pu, 38 * pu; close } }
                body { gradient: spx + 167 * pu - 48 * pu, sby + 84 * pu to spx + 167 * pu + 48 * pu, sby + 84 * pu, mix(#bfb9a5, mix(#000000, tint, pk), 0.66), mix(#bfb9a5, mix(#000000, tint, pk), 0.54) 55%, mix(#bfb9a5, mix(#000000, tint, pk), 0.1); path { at: spx + 167 * pu, sby + 84 * pu; move -47.3 * pu, -38 * pu; line -19.2 * pu, -38 * pu; line -39.9 * pu, 38 * pu; line -67.9 * pu, 38 * pu; close } }
                body { gradient: spx + 167 * pu - 48 * pu, sby + 84 * pu to spx + 167 * pu + 48 * pu, sby + 84 * pu, mix(#2b2833, mix(#000000, tint, pk), 0.66), mix(#2b2833, mix(#000000, tint, pk), 0.54) 55%, mix(#2b2833, mix(#000000, tint, pk), 0.1); path { at: spx + 167 * pu, sby + 84 * pu; move -22.2 * pu, -38 * pu; line 5.9 * pu, -38 * pu; line -14.8 * pu, 38 * pu; line -42.8 * pu, 38 * pu; close } }
                body { gradient: spx + 167 * pu - 48 * pu, sby + 84 * pu to spx + 167 * pu + 48 * pu, sby + 84 * pu, mix(#e63a3a, mix(#000000, tint, pk), 0.66), mix(#e63a3a, mix(#000000, tint, pk), 0.54) 55%, mix(#e63a3a, mix(#000000, tint, pk), 0.1); path { at: spx + 167 * pu, sby + 84 * pu; move 3 * pu, -38 * pu; line 31 * pu, -38 * pu; line 10.3 * pu, 38 * pu; line -17.7 * pu, 38 * pu; close } }
                body { gradient: spx + 167 * pu - 48 * pu, sby + 84 * pu to spx + 167 * pu + 48 * pu, sby + 84 * pu, mix(#d81b60, mix(#000000, tint, pk), 0.66), mix(#d81b60, mix(#000000, tint, pk), 0.54) 55%, mix(#d81b60, mix(#000000, tint, pk), 0.1); path { at: spx + 167 * pu, sby + 84 * pu; move 28.1 * pu, -38 * pu; line 56.1 * pu, -38 * pu; line 35.4 * pu, 38 * pu; line 7.4 * pu, 38 * pu; close } }
                box { at: spx + 167 * pu, sby + 84 * pu; size: 96 * pu, 76 * pu; color: #ffffff; opacity: 8% * theme_hit.8.hover }
            }
            box { at: spx + 167 * pu, sby + 84 * pu; size: 96 * pu, 76 * pu; corner: 14 * pu; stroke: 1.6 * pu; color: mint; opacity: if(theme_sel == 8, 90%, 0) }
            group { scale: rs; pivot: floor(spx + 167 * pu - 40 * pu + 0.5), floor(sby + 84 * pu - 17 * pu + 0.5); text "Retro" { at: floor(spx + 167 * pu - 40 * pu + 0.5), floor(sby + 84 * pu - 17 * pu + 0.5); anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 167 * pu - 40 * pu + 0.5), floor(sby + 84 * pu + 4 * pu + 0.5); text "Plastic" { at: floor(spx + 167 * pu - 40 * pu + 0.5), floor(sby + 84 * pu + 4 * pu + 0.5); anchor: left center; size: 12; weight: 500; width: (80 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            ellipse { at: spx + 167 * pu + -34 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; color: #d6d0bd }
            ellipse { at: spx + 167 * pu + -34 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 167 * pu + -17 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; color: #bfb9a5 }
            ellipse { at: spx + 167 * pu + -17 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 167 * pu + 0 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; color: #2b2833 }
            ellipse { at: spx + 167 * pu + 0 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 167 * pu + 17 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; color: #e63a3a }
            ellipse { at: spx + 167 * pu + 17 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 167 * pu + 34 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; color: #d81b60 }
            ellipse { at: spx + 167 * pu + 34 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 167 * pu + 36 * pu, sby + 84 * pu - 25 * pu; radius: 7 * pu; color: mint; opacity: if(theme_sel == 8, 100%, 0) }
            path { at: spx + 167 * pu + 36 * pu, sby + 84 * pu - 25 * pu; stroke: 1.5 * pu; color: onmint; opacity: if(theme_sel == 8, 100%, 0); move -3 * pu, 0; line -0.9 * pu, 2.5 * pu; line 3.2 * pu, -2.7 * pu }
            zone box theme_hit.8 { at: spx + 167 * pu, sby + 84 * pu; size: 96 * pu, 76 * pu; corner: 14 * pu; cursor: pointer; label: "Retro theme" }
            on press theme_hit.8 { emit theme_pick(8) }
            //  UwU
            group {
                clip inset 0 box { at: spx + 271 * pu, sby + 84 * pu; size: 96 * pu, 76 * pu; corner: 14 * pu }
                body { gradient: spx + 271 * pu - 48 * pu, sby + 84 * pu to spx + 271 * pu + 48 * pu, sby + 84 * pu, mix(#fff2fa, mix(#000000, tint, pk), 0.66), mix(#fff2fa, mix(#000000, tint, pk), 0.54) 55%, mix(#fff2fa, mix(#000000, tint, pk), 0.1); path { at: spx + 271 * pu, sby + 84 * pu; move -72.4 * pu, -38 * pu; line -44.3 * pu, -38 * pu; line -65 * pu, 38 * pu; line -93 * pu, 38 * pu; close } }
                body { gradient: spx + 271 * pu - 48 * pu, sby + 84 * pu to spx + 271 * pu + 48 * pu, sby + 84 * pu, mix(#ffd9ee, mix(#000000, tint, pk), 0.66), mix(#ffd9ee, mix(#000000, tint, pk), 0.54) 55%, mix(#ffd9ee, mix(#000000, tint, pk), 0.1); path { at: spx + 271 * pu, sby + 84 * pu; move -47.3 * pu, -38 * pu; line -19.2 * pu, -38 * pu; line -39.9 * pu, 38 * pu; line -67.9 * pu, 38 * pu; close } }
                body { gradient: spx + 271 * pu - 48 * pu, sby + 84 * pu to spx + 271 * pu + 48 * pu, sby + 84 * pu, mix(#4a2b6b, mix(#000000, tint, pk), 0.66), mix(#4a2b6b, mix(#000000, tint, pk), 0.54) 55%, mix(#4a2b6b, mix(#000000, tint, pk), 0.1); path { at: spx + 271 * pu, sby + 84 * pu; move -22.2 * pu, -38 * pu; line 5.9 * pu, -38 * pu; line -14.8 * pu, 38 * pu; line -42.8 * pu, 38 * pu; close } }
                body { gradient: spx + 271 * pu - 48 * pu, sby + 84 * pu to spx + 271 * pu + 48 * pu, sby + 84 * pu, mix(#ff5fae, mix(#000000, tint, pk), 0.66), mix(#ff5fae, mix(#000000, tint, pk), 0.54) 55%, mix(#ff5fae, mix(#000000, tint, pk), 0.1); path { at: spx + 271 * pu, sby + 84 * pu; move 3 * pu, -38 * pu; line 31 * pu, -38 * pu; line 10.3 * pu, 38 * pu; line -17.7 * pu, 38 * pu; close } }
                body { gradient: spx + 271 * pu - 48 * pu, sby + 84 * pu to spx + 271 * pu + 48 * pu, sby + 84 * pu, mix(#5fe3d6, mix(#000000, tint, pk), 0.66), mix(#5fe3d6, mix(#000000, tint, pk), 0.54) 55%, mix(#5fe3d6, mix(#000000, tint, pk), 0.1); path { at: spx + 271 * pu, sby + 84 * pu; move 28.1 * pu, -38 * pu; line 56.1 * pu, -38 * pu; line 35.4 * pu, 38 * pu; line 7.4 * pu, 38 * pu; close } }
                box { at: spx + 271 * pu, sby + 84 * pu; size: 96 * pu, 76 * pu; color: #ffffff; opacity: 8% * theme_hit.9.hover }
            }
            box { at: spx + 271 * pu, sby + 84 * pu; size: 96 * pu, 76 * pu; corner: 14 * pu; stroke: 1.6 * pu; color: mint; opacity: if(theme_sel == 9, 90%, 0) }
            group { scale: rs; pivot: floor(spx + 271 * pu - 40 * pu + 0.5), floor(sby + 84 * pu - 17 * pu + 0.5); text "UwU" { at: floor(spx + 271 * pu - 40 * pu + 0.5), floor(sby + 84 * pu - 17 * pu + 0.5); anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 271 * pu - 40 * pu + 0.5), floor(sby + 84 * pu + 4 * pu + 0.5); text "Kawaii" { at: floor(spx + 271 * pu - 40 * pu + 0.5), floor(sby + 84 * pu + 4 * pu + 0.5); anchor: left center; size: 12; weight: 500; width: (80 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            ellipse { at: spx + 271 * pu + -34 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; color: #fff2fa }
            ellipse { at: spx + 271 * pu + -34 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 271 * pu + -17 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; color: #ffd9ee }
            ellipse { at: spx + 271 * pu + -17 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 271 * pu + 0 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; color: #4a2b6b }
            ellipse { at: spx + 271 * pu + 0 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 271 * pu + 17 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; color: #ff5fae }
            ellipse { at: spx + 271 * pu + 17 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 271 * pu + 34 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; color: #5fe3d6 }
            ellipse { at: spx + 271 * pu + 34 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 271 * pu + 36 * pu, sby + 84 * pu - 25 * pu; radius: 7 * pu; color: mint; opacity: if(theme_sel == 9, 100%, 0) }
            path { at: spx + 271 * pu + 36 * pu, sby + 84 * pu - 25 * pu; stroke: 1.5 * pu; color: onmint; opacity: if(theme_sel == 9, 100%, 0); move -3 * pu, 0; line -0.9 * pu, 2.5 * pu; line 3.2 * pu, -2.7 * pu }
            zone box theme_hit.9 { at: spx + 271 * pu, sby + 84 * pu; size: 96 * pu, 76 * pu; corner: 14 * pu; cursor: pointer; label: "UwU theme" }
            on press theme_hit.9 { emit theme_pick(9) }
            //  Cyber
            group {
                clip inset 0 box { at: spx + 376 * pu, sby + 84 * pu; size: 96 * pu, 76 * pu; corner: 14 * pu }
                body { gradient: spx + 376 * pu - 48 * pu, sby + 84 * pu to spx + 376 * pu + 48 * pu, sby + 84 * pu, mix(#05080f, mix(#000000, tint, pk), 0.66), mix(#05080f, mix(#000000, tint, pk), 0.54) 55%, mix(#05080f, mix(#000000, tint, pk), 0.1); path { at: spx + 376 * pu, sby + 84 * pu; move -72.4 * pu, -38 * pu; line -44.3 * pu, -38 * pu; line -65 * pu, 38 * pu; line -93 * pu, 38 * pu; close } }
                body { gradient: spx + 376 * pu - 48 * pu, sby + 84 * pu to spx + 376 * pu + 48 * pu, sby + 84 * pu, mix(#0d2438, mix(#000000, tint, pk), 0.66), mix(#0d2438, mix(#000000, tint, pk), 0.54) 55%, mix(#0d2438, mix(#000000, tint, pk), 0.1); path { at: spx + 376 * pu, sby + 84 * pu; move -47.3 * pu, -38 * pu; line -19.2 * pu, -38 * pu; line -39.9 * pu, 38 * pu; line -67.9 * pu, 38 * pu; close } }
                body { gradient: spx + 376 * pu - 48 * pu, sby + 84 * pu to spx + 376 * pu + 48 * pu, sby + 84 * pu, mix(#ff2bd6, mix(#000000, tint, pk), 0.66), mix(#ff2bd6, mix(#000000, tint, pk), 0.54) 55%, mix(#ff2bd6, mix(#000000, tint, pk), 0.1); path { at: spx + 376 * pu, sby + 84 * pu; move -22.2 * pu, -38 * pu; line 5.9 * pu, -38 * pu; line -14.8 * pu, 38 * pu; line -42.8 * pu, 38 * pu; close } }
                body { gradient: spx + 376 * pu - 48 * pu, sby + 84 * pu to spx + 376 * pu + 48 * pu, sby + 84 * pu, mix(#00e5ff, mix(#000000, tint, pk), 0.66), mix(#00e5ff, mix(#000000, tint, pk), 0.54) 55%, mix(#00e5ff, mix(#000000, tint, pk), 0.1); path { at: spx + 376 * pu, sby + 84 * pu; move 3 * pu, -38 * pu; line 31 * pu, -38 * pu; line 10.3 * pu, 38 * pu; line -17.7 * pu, 38 * pu; close } }
                body { gradient: spx + 376 * pu - 48 * pu, sby + 84 * pu to spx + 376 * pu + 48 * pu, sby + 84 * pu, mix(#ff3b5c, mix(#000000, tint, pk), 0.66), mix(#ff3b5c, mix(#000000, tint, pk), 0.54) 55%, mix(#ff3b5c, mix(#000000, tint, pk), 0.1); path { at: spx + 376 * pu, sby + 84 * pu; move 28.1 * pu, -38 * pu; line 56.1 * pu, -38 * pu; line 35.4 * pu, 38 * pu; line 7.4 * pu, 38 * pu; close } }
