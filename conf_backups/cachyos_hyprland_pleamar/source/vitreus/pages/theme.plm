            box { at: spx + 376 * pu, sby + 84 * pu; size: 96 * pu, 76 * pu; corner: 14 * pu; stroke: 1.6 * pu; color: mint; opacity: if(theme_sel == 10, 90%, 0) }
            group { scale: rs; pivot: floor(spx + 376 * pu - 40 * pu + 0.5), floor(sby + 84 * pu - 17 * pu + 0.5); text "Cyber" { at: floor(spx + 376 * pu - 40 * pu + 0.5), floor(sby + 84 * pu - 17 * pu + 0.5); anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 376 * pu - 40 * pu + 0.5), floor(sby + 84 * pu + 4 * pu + 0.5); text "Neon HUD" { at: floor(spx + 376 * pu - 40 * pu + 0.5), floor(sby + 84 * pu + 4 * pu + 0.5); anchor: left center; size: 12; weight: 500; width: (80 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
            ellipse { at: spx + 376 * pu + -34 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; color: #05080f }
            ellipse { at: spx + 376 * pu + -34 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 376 * pu + -17 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; color: #0d2438 }
            ellipse { at: spx + 376 * pu + -17 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 376 * pu + 0 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; color: #ff2bd6 }
            ellipse { at: spx + 376 * pu + 0 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 376 * pu + 17 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; color: #00e5ff }
            ellipse { at: spx + 376 * pu + 17 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 376 * pu + 34 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; color: #ff3b5c }
            ellipse { at: spx + 376 * pu + 34 * pu, sby + 84 * pu + 24 * pu; radius: 6.4 * pu; stroke: 1 * pu; color: ink; opacity: 28% }
            ellipse { at: spx + 376 * pu + 36 * pu, sby + 84 * pu - 25 * pu; radius: 7 * pu; color: mint; opacity: if(theme_sel == 10, 100%, 0) }
            path { at: spx + 376 * pu + 36 * pu, sby + 84 * pu - 25 * pu; stroke: 1.5 * pu; color: onmint; opacity: if(theme_sel == 10, 100%, 0); move -3 * pu, 0; line -0.9 * pu, 2.5 * pu; line 3.2 * pu, -2.7 * pu }
            zone box theme_hit.10 { at: spx + 376 * pu, sby + 84 * pu; size: 96 * pu, 76 * pu; corner: 14 * pu; cursor: pointer; label: "Cyber theme" }
            on press theme_hit.10 { emit theme_pick(10) }
            //  The font: a dropdown of the installed typefaces, a picture of the chosen one under it, and Apply (the shell starts again with it).
            let fnt_y = sby + 164 * pu                       // the trigger's top
            let fnt_x = spx + 14 * pu
            let fnt_w = 410 * pu                             // as wide as the three looks above
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 150 * pu + 0.5); text font_for { at: floor(spx + 14 * pu + 0.5), floor(sby + 150 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" } }
            body { color: mix(obsidian, ink, (7% + 5% * font_hit.hover + 5% * font_dd) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { from: fnt_x, fnt_y; size: fnt_w, 34 * pu; corner: 12 * pu } }
            box { from: fnt_x, fnt_y; size: fnt_w, 34 * pu; corner: 12 * pu; color: ink; opacity: (7% + 5% * font_hit.hover + 5% * font_dd) * (1 - obs) }
            box { from: fnt_x, fnt_y; size: fnt_w, 34 * pu; corner: 12 * pu; stroke: 1.2 * pu; color: mint; opacity: 70% * font_dd }
            group { scale: rs; pivot: floor(fnt_x + 14 * pu + 0.5), floor(fnt_y + 17 * pu + 0.5); text font_name { at: floor(fnt_x + 14 * pu + 0.5), floor(fnt_y + 17 * pu + 0.5); anchor: left center; size: 16; weight: 700; width: (fnt_w - 52 * pu) / rs; lines: 1; color: ink; family: "Space Grotesk" } }
            path { at: fnt_x + fnt_w - 20 * pu, fnt_y + 17 * pu; stroke: 1.6 * pu; color: ink; opacity: 60% + 40% * font_hit.hover; move -4 * pu, (-2 + 4 * font_dd) * pu; line 0, (2 - 4 * font_dd) * pu; line 4 * pu, (-2 + 4 * font_dd) * pu }
            zone box font_hit { from: fnt_x, fnt_y; size: fnt_w, 34 * pu; corner: 12 * pu; cursor: pointer; label: "Font" }
            on press font_hit { toggle font_dd_open; emit font_open; focus font_q }
            //  Apply: only while the choice differs from what is in use. On the label's row, at the right, so the selector keeps its whole width.
            group {
                show: font_dirty
                box { at: spx + 384 * pu, sby + 150 * pu; size: 80 * pu, 24 * pu; corner: 12 * pu; color: mint; opacity: 80% + 20% * font_apply_hit.hover }
                group { scale: rs; pivot: floor(spx + 384 * pu + 0.5), floor(sby + 150 * pu + 0.5); text "Apply" { at: floor(spx + 384 * pu + 0.5), floor(sby + 150 * pu + 0.5); anchor: center; align: center; size: 14; weight: 700; color: onmint; family: "Space Grotesk" } }
                zone box font_apply_hit { at: spx + 384 * pu, sby + 150 * pu; size: 80 * pu, 24 * pu; corner: 12 * pu; cursor: pointer; label: "Apply the font" }
                on press font_apply_hit { emit font_apply }
            }
            //  The preview: the typeface drawn as it will be, with what it will say.
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 232 * pu + 0.5); text "PREVIEW" { at: floor(spx + 14 * pu + 0.5), floor(sby + 232 * pu + 0.5); anchor: left center; size: 12; weight: 700; color: faint; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 424 * pu + 0.5), floor(sby + 232 * pu + 0.5); text font_note { at: floor(spx + 424 * pu + 0.5), floor(sby + 232 * pu + 0.5); anchor: right center; align: right; size: 12.5; width: (260 * pu) / rs; lines: 1; color: mint; family: "Space Grotesk" } }
            body { color: mix(obsidian, ink, (6%) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 296 * pu; size: 438 * pu, 164 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 296 * pu; size: 438 * pu, 164 * pu; corner: 14 * pu; color: ink; opacity: (6%) * (1 - obs) }
            image font_prev { at: spx + 14 * pu, sby + 244 * pu + 6.5 * pu; size: 410 * pu, 127 * pu; tint: ink }
            //  The dropdown, drawn last so its rows win the press over everything under it.
            zone box font_catch { at: spx + 219 * pu, sby + 290 * pu; size: 438 * pu, 330 * pu; active: font_dd_open }
            on press font_catch { font_dd_open = false; blur }
            on scroll font_catch { emit font_scroll(wheel) }
            group {
                show: font_dd > 0.02
                opacity: font_dd
                move: 0, (font_dd - 1) * 6 * pu
                body {
                    color: panel
                    rim: 12%
                    shadow: 0, 6 * pu, 18 * pu, 40%, #000000
                    box { from: fnt_x, fnt_y + 38 * pu; size: fnt_w, 236 * pu; corner: 14 * pu }
                }
                box { from: fnt_x + 6 * pu, fnt_y + 38 * pu + 5 * pu; size: fnt_w - 12 * pu, 28 * pu; corner: 10 * pu; color: ink; opacity: 9% }
                path { at: fnt_x + 20 * pu, fnt_y + 38 * pu + 19 * pu; stroke: 1.5 * pu; color: faint; move 3.2 * pu, 0; line 0, 0 }
                ellipse { at: fnt_x + 19 * pu, fnt_y + 38 * pu + 18 * pu; radius: 4 * pu; stroke: 1.4 * pu; color: faint }
                path { at: fnt_x + 19 * pu, fnt_y + 38 * pu + 18 * pu; stroke: 1.5 * pu; color: faint; move 3 * pu, 3 * pu; line 6 * pu, 6 * pu }
                input font_q { at: floor(fnt_x + 36 * pu + 0.5), floor(fnt_y + 38 * pu + 19 * pu - 9 + 0.5); width: fnt_w - 60 * pu; size: 15; color: ink; family: "Space Grotesk"; placeholder: "Search fonts"; show: font_dd > 0.5 }
                group { scale: rs; pivot: floor(fnt_x + 18 * pu + 0.5), floor(fnt_y + 38 * pu + 100 * pu + 0.5); text "No typeface has that" { at: floor(fnt_x + 18 * pu + 0.5), floor(fnt_y + 38 * pu + 100 * pu + 0.5); anchor: left center; size: 14; color: faint; show: font_none; family: "Space Grotesk" } }
                repeat i in 0..8 {
                    let ry = fnt_y + 38 * pu + 39 * pu + i * 24 * pu + 12 * pu
                    box { at: fnt_x + (fnt_w - 10 * pu) / 2 + 5 * pu, ry; size: fnt_w - 22 * pu, 22 * pu; corner: 11 * pu; color: if(font_r.$i.lit, mint, ink); opacity: if(font_r.$i.on, if(font_r.$i.lit, 24%, 0%) + 10% * font_row_hit.$i.hover, 0%) }
                    group { scale: rs; pivot: floor(fnt_x + 16 * pu + 0.5), floor(ry + 0.5); text font_r.$i.text { at: floor(fnt_x + 16 * pu + 0.5), floor(ry + 0.5); anchor: left center; size: 15; weight: 600; width: (fnt_w - 44 * pu) / rs; lines: 1; color: if(font_r.$i.lit, mint, ink); show: font_r.$i.on; family: "Space Grotesk" } }
                    zone box font_row_hit.$i { at: fnt_x + (fnt_w - 10 * pu) / 2 + 5 * pu, ry; size: fnt_w - 20 * pu, 24 * pu; corner: 12 * pu; cursor: pointer; active: font_r.$i.on and font_dd_open }
                    on press font_row_hit.$i { emit font_pick(i); font_dd_open = false; blur }
                }
                box { at: fnt_x + fnt_w - 6 * pu, fnt_y + 38 * pu + 135 * pu; size: 3 * pu, 190 * pu; corner: 1.5 * pu; color: ink; opacity: 6% }
                box { at: fnt_x + fnt_w - 6 * pu, fnt_y + 38 * pu + 40 * pu + (font_sb_y + font_sb_h / 2) * 190 * pu; size: 3 * pu + 2 * pu * font_bar_hit.hover, max(8 * pu, font_sb_h * 190 * pu); corner: 1.5 * pu; color: mint; opacity: if(font_sb_h < 0.999, 55% + 35% * font_bar_hit.hover, 0%) }
                //  The scrollbar is a handle: pressed or dragged, the list goes to where the pointer is along the track.
                zone box font_bar_hit { at: fnt_x + fnt_w - 7 * pu, fnt_y + 38 * pu + 135 * pu; size: 14 * pu, 196 * pu; cursor: pointer; active: font_dd_open and font_sb_h < 0.999; label: "Font list scrollbar" }
                on press font_bar_hit { emit font_bar(((pointer.y - ty.set) - (fnt_y + 38 * pu + 40 * pu)) / (190 * pu)) }
                on drag font_bar_hit { emit font_bar(((pointer.y - ty.set) - (fnt_y + 38 * pu + 40 * pu)) / (190 * pu)) }
            }
            //  Sound: the one switch, a short click when a panel opens.
            body { color: mix(obsidian, ink, (6%) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + 422 * pu; size: 438 * pu, 40 * pu; corner: 14 * pu } }
            box { at: spx + 219 * pu, sby + 422 * pu; size: 438 * pu, 40 * pu; corner: 14 * pu; color: ink; opacity: (6%) * (1 - obs) }
            group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 422 * pu + 0.5); text "Panel sound" { at: floor(spx + 14 * pu + 0.5), floor(sby + 422 * pu + 0.5); anchor: left center; size: 15; weight: 700; color: ink; family: "Space Grotesk" } }
            group { scale: rs; pivot: floor(spx + 350 * pu + 0.5), floor(sby + 422 * pu + 0.5); text "Play a sound when a panel opens" { at: floor(spx + 350 * pu + 0.5), floor(sby + 422 * pu + 0.5); anchor: right center; size: 13; color: faint; family: "Space Grotesk" } }
            SettingsSwitch(spx + 424 * pu, sby + 422 * pu, snd_pill, snd_hit.pressed, mint)
            zone box snd_hit { at: spx + 405 * pu, sby + 422 * pu; size: 46 * pu, 30 * pu; cursor: pointer; label: "Panel sound" }
            on press snd_hit { emit snd_toggle }
        }
}
