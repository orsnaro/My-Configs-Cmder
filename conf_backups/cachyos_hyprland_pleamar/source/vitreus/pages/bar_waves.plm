            box { at: fwx_30 + if(fwh_30 > 1, 0, 30000), fwy_30; size: fw.bw, fwh_30 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_30, 0 - fwdy_30) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_31 + if(fwh_31 > 1, 0, 30000), fwy_31; size: fw.bw, fwh_31 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_31, 0 - fwdy_31) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_32 + if(fwh_32 > 1, 0, 30000), fwy_32; size: fw.bw, fwh_32 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_32, 0 - fwdy_32) * 1deg; blend: fw.bl * u * bk }
