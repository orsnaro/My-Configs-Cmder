            box { at: fwx_22 + if(fwh_22 > 1, 0, 30000), fwy_22; size: fw.bw, fwh_22 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_22, 0 - fwdy_22) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_23 + if(fwh_23 > 1, 0, 30000), fwy_23; size: fw.bw, fwh_23 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_23, 0 - fwdy_23) * 1deg; blend: fw.bl * u * bk }
