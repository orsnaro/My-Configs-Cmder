#!/usr/bin/env bash
# Start the permanent Vitreus scene with the desktop's session and GPU environment.
set -euo pipefail

export HOME="${HOME:-/home/narol}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export PATH="$HOME/.local/bin:$HOME/.config/pleamar/shells/vitreus/bin:${PATH:-/usr/local/bin:/usr/bin:/bin}"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"

if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    for socket in "$XDG_RUNTIME_DIR"/wayland-*; do
        [ -S "$socket" ] || continue
        case "$socket" in
            *.lock|*.sock) continue ;;
        esac
        WAYLAND_DISPLAY="$(basename "$socket")"
        export WAYLAND_DISPLAY
        break
    done
fi

if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    for directory in "$XDG_RUNTIME_DIR"/hypr/*; do
        [ -d "$directory" ] || continue
        HYPRLAND_INSTANCE_SIGNATURE="$(basename "$directory")"
        export HYPRLAND_INSTANCE_SIGNATURE
        break
    done
fi

# Keep the same AMD adapter as the compositor and the original managed launcher.
export DRI_PRIME=1
export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/radeon_icd.json

shell="$HOME/.config/pleamar/shells/vitreus"
data="$XDG_DATA_HOME/pleamar/vitreus"
# Font names are fixed when Pleamar starts; prepare the saved selection before exec.
"$shell/bin/vitreus-themes" "$data" 2>/dev/null || true
fonts=$(env -u FONTCONFIG_FILE "$shell/bin/vitreus-fonts" "$data" 2>/dev/null) || fonts=""
if [ -n "$fonts" ] && [ -r "$fonts" ]; then
    export FONTCONFIG_FILE="$fonts"
else
    unset FONTCONFIG_FILE
fi

exec "$HOME/.local/bin/pleamar" \
    --scene "$HOME/.config/pleamar/shells/vitreus/vitreus.plm" \
    --no-hud "$@"
