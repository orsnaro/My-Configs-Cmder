#!/usr/bin/env bash
# Spotify app window for ML4W, using the regular Brave profile.
set -euo pipefail

if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && command -v jq >/dev/null; then
    existing=$(hyprctl clients -j 2>/dev/null | jq -r '[.[] | select(.class == "brave-open.spotify.com__-Default") | .address][0] // empty' || true)
    if [[ "$existing" =~ ^0x[[:xdigit:]]+$ ]] &&
        hyprctl dispatch "hl.dsp.focus({ window = 'address:$existing' })" >/dev/null 2>&1; then
        exit 0
    fi
fi

exec brave \
    --ozone-platform-hint=auto \
    --autoplay-policy=no-user-gesture-required \
    --app=https://open.spotify.com/
