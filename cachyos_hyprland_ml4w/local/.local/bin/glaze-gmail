#!/usr/bin/env bash
# Gmail app window for ML4W. Share the regular Brave profile to save RAM.
# KMail stays the mail client everywhere else (Plasma).
set -euo pipefail

if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && command -v jq >/dev/null; then
    existing=$(hyprctl clients -j 2>/dev/null | jq -r '[.[] | select(.class == "brave-mail.google.com__-Default") | .address][0] // empty' || true)
    if [[ "$existing" =~ ^0x[[:xdigit:]]+$ ]] &&
        hyprctl dispatch "hl.dsp.focus({ window = 'address:$existing' })" >/dev/null 2>&1; then
        exit 0
    fi
fi

exec brave \
    --ozone-platform-hint=auto \
    --enable-features=WebRTCPipeWireCapturer \
    --app=https://mail.google.com/
